<Window x:Class="AiAssistant.UI.Windows.CheckpointDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkpoint Changes" Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    
    <Window.Resources>
        <!-- Icon geometries -->
        <Geometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="IconMinus">M19,13H5V11H19V13Z</Geometry>
        <Geometry x:Key="IconEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</Geometry>
        <Geometry x:Key="IconFile">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</Geometry>

        <!-- Triggers for ChangeType -->
        <Style x:Key="ChangeTypeIconStyle" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChangeType}" Value="added">
                    <Setter Property="Data" Value="{StaticResource IconPlus}"/>
                    <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeType}" Value="deleted">
                    <Setter Property="Data" Value="{StaticResource IconMinus}"/>
                    <Setter Property="Fill" Value="{DynamicResource ErrorRedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeType}" Value="modified">
                    <Setter Property="Data" Value="{StaticResource IconEdit}"/>
                    <Setter Property="Fill" Value="{DynamicResource WarningOrangeBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChangeTypeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChangeType}" Value="added">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                    <Setter Property="Text" Value="Added"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeType}" Value="deleted">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}"/>
                    <Setter Property="Text" Value="Deleted"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeType}" Value="modified">
                    <Setter Property="Foreground" Value="{DynamicResource WarningOrangeBrush}"/>
                    <Setter Property="Text" Value="Modified"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header matching ChatPanel theme -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColorBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource AccentSurfaceBrush}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconFile}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" />
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Checkpoint Comparison" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Double-click any file below to open it in the diff viewer." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ListBox x:Name="FilesListView" Grid.Row="1" 
                 Background="Transparent" BorderThickness="0" 
                 Padding="8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="4,4,4,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{DynamicResource SurfaceColorBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource MediumRadius}"
                                        Padding="16,12">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="true">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Change Type -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource ChangeTypeIconStyle}" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource ChangeTypeTextStyle}"/>
                        </StackPanel>

                        <!-- File Path -->
                        <TextBlock Grid.Column="1" Text="{Binding FilePath}" 
                                   FontFamily="{DynamicResource CodeFont}"
                                   VerticalAlignment="Center" Margin="12,0,12,0" 
                                   TextTrimming="CharacterEllipsis" 
                                   ToolTip="{Binding FilePath}"/>

                        <!-- Line Changes -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Lines Added Badge -->
                            <TextBlock Text="{Binding LinesAdded, StringFormat='+{0}'}" 
                                       Foreground="{DynamicResource SuccessGreenBrush}" 
                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" MinWidth="35" TextAlignment="Right"/>
                            
                            <!-- Lines Removed Badge -->
                            <TextBlock Text="{Binding LinesRemoved, StringFormat='-{0}'}" 
                                       Foreground="{DynamicResource ErrorRedBrush}" 
                                       FontWeight="SemiBold" FontSize="12" MinWidth="35" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColorBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="100" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

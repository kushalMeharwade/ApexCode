<UserControl x:Class="AiAssistant.UI.Controls.PlanReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AiAssistant.UI.Controls"
             xmlns:vm="clr-namespace:AiAssistant.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EnhancedPlanReviewPanelViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- DataTemplate for Section Rows (Important Changes, Decisions, Risks, Questions) -->
        <DataTemplate DataType="{x:Type vm:PlanSectionRowViewModel}">
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,12" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding IndexText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Padding="0"/>
                        
                        <ToggleButton Grid.Column="2" 
                                      IsChecked="{Binding IsCommentVisible}" 
                                      Content="💬"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Margin="8,0,0,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    
                    <!-- Comment Box -->
                    <Grid Grid.Row="1" Margin="16,8,0,0" Visibility="{Binding IsCommentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" 
                                 local:FocusHelper.IsFocused="{Binding IsCommentVisible}"
                                 IsReadOnly="{Binding IsSent}"
                                 TextWrapping="Wrap" MinLines="2"
                                 Background="{DynamicResource PanelBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                        <TextBlock Grid.Column="1" Text="✔ Sent" 
                                   Foreground="{DynamicResource SuccessBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- DataTemplate for File Rows -->
        <DataTemplate DataType="{x:Type vm:PlanFileRowViewModel}">
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,12" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{Binding IndexText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                            <!-- Badge -->
                            <Border Background="{Binding ActionBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,0,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Action}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <TextBox Text="{Binding Path, Mode=OneWay}" ToolTip="{Binding Path}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Padding="0"/>
                            <TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Padding="0"/>
                        </StackPanel>
                        
                        <ToggleButton Grid.Column="2" 
                                      IsChecked="{Binding IsCommentVisible}" 
                                      Content="💬"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Margin="8,0,0,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    
                    <!-- Comment Box -->
                    <Grid Grid.Row="1" Margin="16,8,0,0" Visibility="{Binding IsCommentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" 
                                 local:FocusHelper.IsFocused="{Binding IsCommentVisible}"
                                 IsReadOnly="{Binding IsSent}"
                                 TextWrapping="Wrap" MinLines="2"
                                 Background="{DynamicResource PanelBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                        <TextBlock Grid.Column="1" Text="✔ Sent" 
                                   Foreground="{DynamicResource SuccessBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- Expander Header Style -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            Background="{DynamicResource SurfaceColorBrush}"
            CornerRadius="8"
            Margin="0,8,0,8"
            Padding="0">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Content (Scrollable) -->
            <RowDefinition Height="Auto"/> <!-- General Feedback -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource TextTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRevision}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RevisionLabel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </WrapPanel>
                    <ToggleButton Grid.Column="1" IsChecked="{Binding IsCollapsed, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Content" Value="Hide plan"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Content" Value="View plan"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>
                
                <!-- Status Pill and Actions -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding StatusBrush}" Opacity="0.8" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding CopyButtonText}" ToolTip="Copy Markdown" Command="{Binding CopyCommand}" 
                                Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Padding="8,4"/>
                        <Button Content="Download" ToolTip="Download Markdown" Command="{Binding DownloadCommand}" 
                                Style="{DynamicResource GhostButton}" Margin="4,0,0,0" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
                
                <!-- Summary -->
                <Border Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Summary" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Important Changes -->
                <Expander IsExpanded="True" Visibility="{Binding HasImportantChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="{Binding ImportantChanges.Count, StringFormat='Important changes · {0}'}" FontWeight="SemiBold" FontSize="14"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding ImportantChanges}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>

                <!-- Modified Files -->
                <Expander IsExpanded="True" Visibility="{Binding HasModifiedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="{Binding ModifiedFiles.Count, StringFormat='Modified files · {0}'}" FontWeight="SemiBold" FontSize="14"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding ModifiedFiles}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
                
                <!-- Risks (Tinted Background) -->
                <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="4,0,0,0" Background="#11FF0000" Margin="0,0,0,0" Visibility="{Binding HasRisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="{Binding Risks.Count, StringFormat='⚠ Risks · {0}'}" FontWeight="SemiBold" FontSize="14"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Risks}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Expander>
                </Border>

                <!-- Decisions -->
                <Expander IsExpanded="False" Visibility="{Binding HasDecisions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Decisions.Count, StringFormat='Decisions · {0}'}" FontWeight="SemiBold" FontSize="14"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>

                <!-- Open Questions -->
                <Expander IsExpanded="False" Visibility="{Binding HasOpenQuestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="{Binding OpenQuestions.Count, StringFormat='Open questions · {0}'}" FontWeight="SemiBold" FontSize="14"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding OpenQuestions}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        
        <!-- General Feedback -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,12" Background="{DynamicResource PanelBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="General Feedback" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Text="{Binding GeneralFeedback, UpdateSourceTrigger=PropertyChanged}" 
                         IsReadOnly="{Binding IsReadOnly}"
                         TextWrapping="Wrap" MinLines="3" MaxLines="6" AcceptsReturn="True"
                         Background="{DynamicResource SurfaceColorBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                         
                <!-- Error Message -->
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                         
                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Request changes" Command="{Binding RequestChangesCommand}" IsEnabled="{Binding IsInteractive}"
                            Style="{DynamicResource GhostButton}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="PROCEED" Command="{Binding ProceedCommand}" IsEnabled="{Binding IsInteractive}"
                            Style="{DynamicResource PrimaryButton}" Padding="16,6" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        </Grid>
    </Border>
</UserControl>

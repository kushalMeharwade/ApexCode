<UserControl x:Class="AiAssistant.UI.Controls.TaskExecutionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AiAssistant.UI.Controls"
             xmlns:vm="clr-namespace:AiAssistant.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TaskExecutionPanelViewModel}"
             Background="{DynamicResource PanelBackgroundBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Geometry x:Key="IconChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</Geometry>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Summary Strip (Collapsible Header) -->
            <ToggleButton Grid.Row="0" x:Name="HeaderToggleButton" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconChevronDown}" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                          x:Name="ChevronPath" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentTaskSummary}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <ProgressBar Height="2" Style="{DynamicResource MeterProgressBar}" Maximum="100" Value="{Binding TaskProgressValue, Mode=OneWay}" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding CurrentTaskTitle}" FontSize="{DynamicResource SmallFontSizeOverride}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                           
                                <Button Grid.Column="3" Content="View Plan" Style="{DynamicResource GhostButton}" Padding="8,2" Command="{Binding ViewPlanCommand}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChevronPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            
            <!-- Collapsible Content: Task List -->
            <Grid Grid.Row="1" x:Name="DetailsGrid" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="36,4,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Indicator -->
                                    <Path Grid.Column="0" Grid.Row="0" Width="14" Height="14" Stretch="Uniform" 
                                          Margin="0,2,10,0" VerticalAlignment="Top">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <!-- Default: Pending -->
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                                <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                                        <Setter Property="Data" Value="M21,7L9,19L3,14L4.41,12.59L9,17.17L19.59,6.58L21,7Z"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorRedBrush}"/>
                                                        <Setter Property="Data" Value="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16,16L12,12L8,16L6,14L10,10L6,6L8,4L12,8L16,4L18,6L14,10L18,14Z"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Interrupted">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningYellowBrush}"/>
                                                        <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17V15H13V17H11M11,13V7H13V13H11Z"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <!-- Task Info -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" x:Name="TaskInfoPanel">
                                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TaskDescText" Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        
                                        <!-- Error Message -->
                                        <TextBlock Text="{Binding FailureMessage}" Foreground="{DynamicResource ErrorRedBrush}" 
                                                   TextWrapping="Wrap" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- Row Actions -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Interrupted">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="Retry Task" Style="{DynamicResource PrimaryButton}" Padding="12,4" Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                                        <Button Content="Skip Task" Style="{DynamicResource SecondaryButton}" Padding="12,4" Command="{Binding DataContext.SkipTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Completed Tasks: Struck-through and muted -->
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="TaskTitleText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="TaskDescText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- Pending/Skipped Tasks: Muted, just status glance -->
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter TargetName="TaskTitleText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="TaskTitleText" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="TaskDescText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter TargetName="TaskTitleText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="TaskTitleText" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="TaskDescText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Panel Actions -->
                <Border Grid.Row="1" Padding="12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailedTask}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Abort pushed to bottom right and lowered opacity/prominence -->
                        <Button Content="Abort Remaining Tasks" Command="{Binding AbortPlanCommand}" 
                                Foreground="{DynamicResource ErrorRedBrush}" Style="{DynamicResource GhostButton}" 
                                HorizontalAlignment="Right" Opacity="0.7" ToolTip="Cancel all remaining tasks" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

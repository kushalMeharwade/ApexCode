<UserControl x:Class="AiAssistant.UI.Controls.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiAssistant.UI.Controls"
             xmlns:converters="clr-namespace:AiAssistant.UI.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AiAssistant.UI;component/Themes/ControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AiAssistant.UI;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Storyboard for loading animation -->
            <Storyboard x:Key="LoadingAnimationStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="LoadingTextBlock" 
                                 Storyboard.TargetProperty="Opacity" 
                                 From="1.0" To="0.5" Duration="0:0:0.8" AutoReverse="True" />
                <DoubleAnimation Storyboard.TargetName="LoadingRingTransform" 
                                 Storyboard.TargetProperty="Angle" 
                                 From="0" To="360" Duration="0:0:1" />
            </Storyboard>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:ExpandCollapseIconConverter x:Key="ExpandCollapseIconConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Row 0: Header ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceColorBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back" Click="BackButton_Click"
                        ToolTip="Back to chat"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="Chat History"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Row 1: Search bar ──────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceColorBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         TextChanged="SearchBox_TextChanged"
                         FontSize="{DynamicResource InputFontSizeOverride}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Padding="10,6,32,6" />
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="0"
                           Text="🔍  Search conversations…"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="{DynamicResource InputFontSizeOverride}"
                           VerticalAlignment="Center"
                           Padding="14,0,0,0"
                           IsHitTestVisible="False" />
                <Button x:Name="FilterToggleBtn" Grid.Column="1"
                        Content="⚙ Filters"
                        Click="FilterToggleBtn_Click"
                        ToolTip="Toggle date filters"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0" />
            </Grid>
        </Border>

        <!-- ── Row 2: Date filter bar (collapsed by default) ─────────── -->
        <Border x:Name="DateFiltersPanel" Grid.Row="2"
                Background="{DynamicResource SurfaceColorBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <DatePicker x:Name="FromDatePicker" Width="130"
                            SelectedDateChanged="DateFilter_Changed" />
                <TextBlock Text="to"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           FontSize="{DynamicResource InputFontSizeOverride}" />
                <DatePicker x:Name="ToDatePicker" Width="130"
                            Margin="0,0,10,0"
                            SelectedDateChanged="DateFilter_Changed" />
                <Button Content="Clear" Click="ClearFilters_Click"
                        Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Border>

        <!-- ── Row 3: Conversation list ──────────────────────────────── -->
        <Grid Grid.Row="3">

            <StackPanel x:Name="LoadingStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="10">
                <Path Data="M 20,2 A 18,18 0 1,1 2,20" 
                      Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="4" 
                      Width="40" Height="40" RenderTransformOrigin="0.5,0.5" 
                      HorizontalAlignment="Center" Margin="0,0,0,16" Stretch="None">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LoadingRingTransform" Angle="0" />
                    </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="LoadingTextBlock" Text="Loading chat history..." 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="{DynamicResource AppFontSizeOverride}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyStateText" Text="No chat history found. Start a new conversation to get started!"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="{DynamicResource AppFontSizeOverride}"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />
                <Button Content="➕ Start a new chat"
                        Click="NewChatFromEmptyState_Click"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Grouped list -->
            <ListBox x:Name="HistoryGroupsList"
                     ItemsSource="{Binding GroupedItems}"
                     Margin="6,4,6,8"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     HorizontalContentAlignment="Stretch">
                
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel Margin="0,4,0,0">
                                                <ToggleButton x:Name="ExpanderBtn" 
                                                              IsChecked="True"
                                                              HorizontalContentAlignment="Left"
                                                              Padding="4,5"
                                                              FocusVisualStyle="{x:Null}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IsChecked, ElementName=ExpanderBtn, Converter={StaticResource ExpandCollapseIconConverter}}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ItemsPresenter x:Name="Items" Visibility="Visible" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" SourceName="ExpanderBtn" Value="False">
                                                    <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Card -->
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MediumRadius}"
                                Margin="0,2"
                                Padding="12,10"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceColorBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Title row (title + action buttons) -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title — view mode (Border clips to one line) -->
                                    <Border Grid.Column="0" Height="20" ClipToBounds="True" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   MouseLeftButtonUp="ItemText_Click"
                                                   Tag="{Binding}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Title — rename / edit mode -->
                                    <TextBox Grid.Column="0"
                                             x:Name="RenameTextBox"
                                             Text="{Binding Name, Mode=OneWay}"
                                             FontSize="13"
                                             Padding="2,1"
                                             Tag="{Binding}"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                                    <!-- Rename + Delete buttons (always in layout, opacity controlled by card hover) -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0">
                                        <Button Content="✏"
                                                ToolTip="Rename"
                                                Click="RenameBtn_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="5,3"
                                                FontSize="11"
                                                AutomationProperties.Name="Rename conversation" />
                                        <Button Content="🗑"
                                                ToolTip="Delete"
                                                Click="DeleteBtn_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="5,3"
                                                FontSize="11"
                                                AutomationProperties.Name="Delete conversation" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: First message preview — one line via MaxHeight clip -->
                                <Border Grid.Row="1" MaxHeight="16" ClipToBounds="True" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding FirstPrompt}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               MouseLeftButtonUp="ItemText_Click"
                                               Tag="{Binding}" />
                                </Border>

                                <!-- Row 2: Relative time -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding RelativeTime}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,0"
                                           MouseLeftButtonUp="ItemText_Click"
                                           Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Overlay dialog -->
        <local:ConfirmationOverlay x:Name="ConfirmOverlay" Grid.RowSpan="4" Panel.ZIndex="100" />
    </Grid>
</UserControl>

<UserControl x:Class="AiAssistant.UI.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AiAssistant.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource VsBrush.ToolWindowBackground}"
             Foreground="{DynamicResource VsBrush.ToolWindowText}">
    
    <UserControl.Resources>
        <local:CategoryToBrushConverter x:Key="CategoryToBrushConverter"/>
        <local:TruncateTextConverter x:Key="TruncateTextConverter" MaxLength="15000"/>
        
        <DataTemplate x:Key="HistoryItemTemplate">
            <Border Margin="4,4,4,8" Padding="12" Background="{DynamicResource VsBrush.Window}" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Timestamp, StringFormat=[HH:mm:ss.fff]}" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.5" FontFamily="Consolas" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Category}" Foreground="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.9" LineHeight="20" Margin="0,0,0,4"/>
                    <Expander Header="Details" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.7" Margin="0,8,0,0"
                              Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{DynamicResource VsBrush.ToolWindowBackground}" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                            <TextBox Text="{Binding Detail, Mode=OneWay, Converter={StaticResource TruncateTextConverter}}" TextWrapping="Wrap" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.8" Background="Transparent" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas"/>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TransactionItemTemplate">
            <Border Margin="4,4,4,6" Padding="10" Background="{DynamicResource VsBrush.Window}" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding StartTime, StringFormat=[HH:mm:ss]}" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.5" FontFamily="Consolas" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Provider}" Foreground="DodgerBlue" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="MediumSeaGreen" FontWeight="Medium" FontSize="12" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Duration, StringFormat={}{0:s\\.fff}s}" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.6" FontSize="11"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <TabControl Background="Transparent" BorderThickness="0,1,0,0">
            <TabItem Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" Background="{DynamicResource VsBrush.Window}" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Clear" Click="ClearButton_Click" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Copy" Click="CopyButton_Click" ToolTip="Copy all history to clipboard" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="JSON" Click="ExportJsonButton_Click" ToolTip="Export history to JSON" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Text" Click="ExportTextButton_Click" ToolTip="Export history to Text (Markdown)" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Filters:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.8" FontWeight="SemiBold"/>
                                <CheckBox Content="Chat" x:Name="FilterChat" Foreground="{DynamicResource VsBrush.WindowText}" IsChecked="True" VerticalAlignment="Center" Margin="4,0,8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox Content="LLM" x:Name="FilterLlm" Foreground="{DynamicResource VsBrush.WindowText}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox Content="Tools" x:Name="FilterTool" Foreground="{DynamicResource VsBrush.WindowText}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox Content="Agent" x:Name="FilterAgent" Foreground="{DynamicResource VsBrush.WindowText}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox Content="Settings" x:Name="FilterSettings" Foreground="{DynamicResource VsBrush.WindowText}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,4,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- History ListView -->
                    <ListView x:Name="HistoryListView" Grid.Row="1" 
                              ItemsSource="{Binding FilteredHistoryEntries}" 
                              ItemTemplate="{StaticResource HistoryItemTemplate}"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              Background="Transparent" BorderThickness="0"
                              Padding="8"
                              HorizontalContentAlignment="Stretch"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Raw">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" Background="{DynamicResource VsBrush.Window}" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Clear" Click="ClearTransactions_Click" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="JSON" Click="RawExportAllJsonButton_Click" ToolTip="Export all transactions to JSON" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Text" Click="RawExportAllTextButton_Click" ToolTip="Export all transactions to Text (Markdown)" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderThickness="1" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="TransactionsListView" Grid.Row="1" 
                                  ItemsSource="{Binding TransactionEntries}"
                                  ItemTemplate="{StaticResource TransactionItemTemplate}"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  Background="Transparent" BorderThickness="0,1,1,0" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}"
                                  Padding="4"
                                  HorizontalContentAlignment="Stretch"/>
                    </Grid>
                    
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                    
                    <Grid Grid.Column="2" Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" Background="{DynamicResource VsBrush.Window}" Padding="12,8"
                                Visibility="{Binding SelectedItem, ElementName=TransactionsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy Response" Click="RawCopyButton_Click" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Copy Request" Click="RawCopyReqButton_Click" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Open as File" Click="RawOpenAsFileButton_Click" Padding="12,4" Margin="0,0,6,0" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                                <Button Content="Export..." Click="RawExportButton_Click" Padding="12,4" Background="{DynamicResource VsBrush.ButtonFace}" Foreground="{DynamicResource VsBrush.ButtonText}" BorderBrush="{DynamicResource VsBrush.ButtonBorder}"/>
                            </StackPanel>
                        </Border>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Request Payload:" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource VsBrush.WindowText}"/>
                                <Border Background="{DynamicResource VsBrush.Window}" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,24">
                                    <TextBox Text="{Binding SelectedItem.RequestPayload, ElementName=TransactionsListView, Mode=OneWay, Converter={StaticResource TruncateTextConverter}}" 
                                             IsReadOnly="True" FontFamily="Consolas" 
                                             Background="Transparent" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.8"
                                             BorderThickness="0" />
                                </Border>
                                         
                                <TextBlock Text="Response Payload / Error:" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource VsBrush.WindowText}"/>
                                <Border Background="{DynamicResource VsBrush.Window}" BorderBrush="{DynamicResource VsBrush.ToolWindowBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SelectedItem.ResponseOrError, ElementName=TransactionsListView, Mode=OneWay, Converter={StaticResource TruncateTextConverter}}" 
                                             IsReadOnly="True" FontFamily="Consolas" 
                                             Background="Transparent" Foreground="{DynamicResource VsBrush.WindowText}" Opacity="0.8"
                                             BorderThickness="0" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="AiAssistant.UI.Controls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiAssistant.UI.Controls"
             xmlns:converters="clr-namespace:AiAssistant.UI.Converters"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AiAssistant.UI;component/Themes/ControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AiAssistant.UI;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
            <converters:LogoKeyToUriConverter x:Key="LogoKeyToUriConverter" />
            <converters:PersonaLogoKeyToUriConverter x:Key="PersonaLogoKeyToUriConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            
            <!-- Global Styles -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="BorderThickness" Value="1" />
                <!-- FIX: was a hardcoded translucent white overlay (#22FFFFFF). That reads as
                     a soft highlight on a dark background, but the identical white-on-white
                     is invisible on the light theme's white card / light-gray page — every
                     card lost its outline and the whole settings screen looked flat and
                     undifferentiated. BorderSubtleBrush already has a correct value for both
                     themes (dark: #3F3F46, light: #CCCCCC), so cards now separate from the
                     page in both. -->
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceColorBrush}" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            </Style>

            <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="SecondaryBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <!-- FIX: "BackgroundSecondaryBrush" is not defined anywhere in the
                                         theme dictionaries, so this hover state silently did nothing
                                         in either theme. -->
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="border" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="DestructiveBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ErrorRedBrush}" />
            </Style>
            
            <Geometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
            <Geometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z</Geometry>
            <Geometry x:Key="IconEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</Geometry>
            <Geometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
            <Geometry x:Key="IconDelete">M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z</Geometry>
            <Geometry x:Key="IconPlug">M16,7V3H14V7H10V3H8V7H8C7,7 6,8 6,9V14.5L9.5,18V21H14.5V18L18,14.5V9C18,8 17,7 16,7M16,14L13.5,16.5V19H10.5V16.5L8,14V9H16V14Z</Geometry>
            <Geometry x:Key="IconBrain">M15.5,3.5C14.5,3.5 13.6,4 13,4.8C12.4,4 11.5,3.5 10.5,3.5C8.6,3.5 7,5.1 7,7C7,7.2 7,7.4 7.1,7.6C5.3,8.1 4,9.9 4,12C4,14.2 5.6,16.1 7.7,16.4C7.9,18.4 9.6,20 11.7,20H12.5C12.8,20 13,19.8 13,19.5V18C13,17.4 13.4,17 14,17H15.5C17.4,17 19,15.4 19,13.5C19,12.8 18.8,12 18.4,11.4C19.4,10.6 20,9.4 20,8C20,5.5 18,3.5 15.5,3.5M10.5,5.5C11.3,5.5 12,6.2 12,7H9C9,6.2 9.7,5.5 10.5,5.5M15.5,5.5C16.9,5.5 18,6.6 18,8C18,9.2 17.2,10.2 16,10.4C16,10.2 16,10 16,9.8V9.5C16,9.2 15.8,9 15.5,9H14V7.5C14,7.2 13.8,7 13.5,7H12.5C12.2,7 12,7.2 12,7.5V9H10.5C10.2,9 10,9.2 10,9.5V11.5C10,11.8 10.2,12 10.5,12H12C12.6,12 13,12.4 13,13V15.5C13,15.8 12.8,16 12.5,16H11.7C10.6,16 9.7,15.1 9.7,14C9.7,13.4 10.2,13 10.7,13H11V11H9.7C9.3,11 9,10.7 9,10.3C9,9.8 9.3,9.4 9.8,9.2C10,9.1 10,8.9 10,8.7V7.2C8,7.6 6.5,9.4 6.5,11.5C6.5,13.7 8.3,15.5 10.5,15.5C11.1,15.5 11.6,15.4 12.1,15.2C12.7,16.8 14.1,18 15.8,18H17V19.5H15.5C13.4,19.5 11.6,17.9 11.2,15.9C10.9,16 10.7,16 10.5,16C8.3,16 6.5,14.2 6.5,12C6.5,9.8 8.3,8 10.5,8H11.5V10H13V8.5H14.5V11H16C16,11.2 16,11.3 16,11.5C16,13.4 14.4,15 12.5,15H11.5C11.2,15 11,15.2 11,15.5C11,15.8 11.2,16 11.5,16H12.5C14.5,16 16,14.4 16,12.5H17.5C17.8,12.5 18,12.3 18,12V11.7C18.6,11 19,10.1 19,9C19,7.3 17.7,6 16,6C15.8,6 15.6,6.1 15.5,6.1V5.5Z</Geometry>
            <Geometry x:Key="IconBack">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>
            <Geometry x:Key="IconDocument">M14,2H6C4.89,2 4,2.89 4,4V20C4,21.11 4.89,22 6,22H18C19.11,22 20,21.11 20,20V8L14,2M13,9V3.5L18.5,9H13Z</Geometry>
            <Geometry x:Key="IconDatabase">M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z</Geometry>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Back button (visible only in overlay mode) -->
        <Border x:Name="SettingsHeaderGrid" Grid.Row="0" Background="{DynamicResource SurfaceColorBrush}" Padding="16,10"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click"
                        ToolTip="Back to chat" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBack}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" />
                        <TextBlock Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="Settings" FontWeight="Bold"
                           FontSize="{DynamicResource AppFontSizeOverride}"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="FullScreenBtn" Grid.Column="2" Click="FullScreenBtn_Click" ToolTip="Open full screen settings" Style="{StaticResource GhostButton}" Padding="4" VerticalAlignment="Center">
                    <Path Data="M 2 2 L 6 2 L 6 3 L 3 3 L 3 6 L 2 6 Z M 14 2 L 10 2 L 10 3 L 13 3 L 13 6 L 14 6 Z M 2 14 L 2 10 L 3 10 L 3 13 L 6 13 L 6 14 Z M 14 14 L 10 14 L 10 13 L 13 13 L 13 10 L 14 10 Z" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <!-- Tab Navigation and Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" TabStripPlacement="Top" Margin="0,8,0,0">
            <TabControl.Resources>
                <!-- Style for TabItems to look like top navigation -->
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Height="30" Padding="2,0" Margin="1,0,1,0" Background="Transparent" Cursor="Hand" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <!-- FIX: was "#1A007ACC" — a fixed blue-tinted overlay unrelated to
                                             the app's own purple accent, and with no light-theme variant.
                                             AccentSurfaceBrush already tracks the accent color per theme. -->
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                        <Setter Property="TextElement.FontWeight" TargetName="ContentSite" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <!-- FIX: was "#0CFFFFFF", a translucent white overlay invisible on
                                             the light theme's near-white background. SurfaceTertiaryBrush
                                             gives a visible hover state in both themes. -->
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                
                <!-- Shared Header Style -->
                <Style x:Key="TabHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Margin" Value="0,0,0,24" />
                    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                </Style>
            </TabControl.Resources>

            <!-- GENERAL TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSettings}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,6,0" />
                        <TextBlock Text="General" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="General Settings" Style="{StaticResource TabHeaderStyle}" Margin="0" />
                                <Button x:Name="ResetDefaultsBtn" Grid.Column="1" Content="Reset defaults" FontSize="12"
                                        Style="{StaticResource GhostButton}" Click="ResetDefaultsBtn_Click" VerticalAlignment="Center" />
                            </Grid>
                            
                            <TextBlock Grid.Row="1" x:Name="ErrorTextBlock" Foreground="{DynamicResource ErrorRedBrush}" FontSize="13"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                            <TextBlock Grid.Row="2" Text="Appearance" Style="{StaticResource SectionHeader}" />
                            <Border Grid.Row="3" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton x:Name="ThemeDarkPill" GroupName="Theme" Content="Dark" Tag="dark" Style="{StaticResource PillToggleButton}" Checked="ThemePill_Checked" />
                                        <RadioButton x:Name="ThemeLightPill" GroupName="Theme" Content="Light" Tag="light" Style="{StaticResource PillToggleButton}" Margin="8,0,0,0" Checked="ThemePill_Checked" />
                                        <RadioButton x:Name="ThemeAutoPill" GroupName="Theme" Content="Auto" Tag="auto" Style="{StaticResource PillToggleButton}" Margin="8,0,0,0" Checked="ThemePill_Checked" />
                                        <ComboBox x:Name="ThemeCombo" Visibility="Collapsed">
                                            <ComboBoxItem Content="Dark" Tag="dark" />
                                            <ComboBoxItem Content="Light" Tag="light" />
                                            <ComboBoxItem Content="Auto" Tag="auto" />
                                        </ComboBox>
                                    </StackPanel>
                                    <!-- 
                                    <TextBlock Text="Language" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource Combo}" SelectionChanged="LanguageCombo_SelectionChanged">
                                        <ComboBoxItem Content="English"/>
                                        <ComboBoxItem Content="Spanish"/>
                                        <ComboBoxItem Content="French"/>
                                        <ComboBoxItem Content="German"/>
                                        <ComboBoxItem Content="Chinese"/>
                                        <ComboBoxItem Content="Japanese"/>
                                        <ComboBoxItem Content="Korean"/>
                                    </ComboBox>
                                    <TextBlock Text="Country" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="CountryCombo" Style="{StaticResource Combo}" SelectionChanged="CountryCombo_SelectionChanged">
                                        <ComboBoxItem Content="United States"/>
                                        <ComboBoxItem Content="United Kingdom"/>
                                        <ComboBoxItem Content="Canada"/>
                                        <ComboBoxItem Content="Australia"/>
                                        <ComboBoxItem Content="India"/>
                                        <ComboBoxItem Content="Germany"/>
                                        <ComboBoxItem Content="France"/>
                                        <ComboBoxItem Content="Spain"/>
                                        <ComboBoxItem Content="Mexico"/>
                                        <ComboBoxItem Content="Japan"/>
                                        <ComboBoxItem Content="South Korea"/>
                                        <ComboBoxItem Content="China"/>
                                    </ComboBox>
                                    -->

                                    <TextBlock Text="App font family" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="AppFontFamilyCombo" Style="{StaticResource Combo}" SelectionChanged="AppFontFamilyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" IsSelected="True" />
                                        <ComboBoxItem Content="Inter" Tag="Inter" />
                                        <ComboBoxItem Content="Helvetica" Tag="Helvetica" />
                                        <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                        <ComboBoxItem Content="System" Tag="System" />
                                    </ComboBox>

                                    <TextBlock Text="Code font family" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="CodeFontFamilyCombo" Style="{StaticResource Combo}" Margin="0,0,0,4" SelectionChanged="CodeFontFamilyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Consolas" Tag="Consolas" IsSelected="True" />
                                        <ComboBoxItem Content="Courier New" Tag="Courier New" />
                                        <ComboBoxItem Content="Fira Code" Tag="Fira Code" />
                                        <ComboBoxItem Content="System" Tag="System" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="4" Text="Font sizes" Style="{StaticResource SectionHeader}" />
                            <Border Grid.Row="5" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Global font size" Style="{StaticResource LabelStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="AppFontSlider" Minimum="-4" Maximum="29" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="AppFontSlider_ValueChanged" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,4" VerticalAlignment="Center">
                                            <TextBox x:Name="AppFontSizeInput" Width="40" Padding="0" Text="13" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" PreviewTextInput="NumericInput_PreviewTextInput" LostFocus="FontSizeInput_LostFocus" KeyDown="FontSizeInput_KeyDown" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Message font size" Style="{StaticResource LabelStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MessageFontSlider" Minimum="-4" Maximum="29" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="MessageFontSlider_ValueChanged" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,4" VerticalAlignment="Center">
                                            <TextBox x:Name="MessageFontSizeInput" Width="40" Padding="0" Text="13" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" PreviewTextInput="NumericInput_PreviewTextInput" LostFocus="FontSizeInput_LostFocus" KeyDown="FontSizeInput_KeyDown" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Input font size" Style="{StaticResource LabelStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="InputFontSlider" Minimum="-4" Maximum="29" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="InputFontSlider_ValueChanged" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,4" VerticalAlignment="Center">
                                            <TextBox x:Name="InputFontSizeInput" Width="40" Padding="0" Text="13" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" PreviewTextInput="NumericInput_PreviewTextInput" LostFocus="FontSizeInput_LostFocus" KeyDown="FontSizeInput_KeyDown" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Code font size" Style="{StaticResource LabelStyle}" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CodeFontSlider" Minimum="-4" Maximum="29" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="CodeFontSlider_ValueChanged" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,4" VerticalAlignment="Center">
                                            <TextBox x:Name="CodeFontSizeInput" Width="40" Padding="0" Text="13" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" PreviewTextInput="NumericInput_PreviewTextInput" LostFocus="FontSizeInput_LostFocus" KeyDown="FontSizeInput_KeyDown" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Grid.Row="6" Text="Workspace search extensions" Style="{StaticResource SectionHeader}" />
                            <Border Grid.Row="7" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="These extensions determine which files are indexed and shown when typing @ in the chat panel." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="New extension (e.g. .xaml):" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewExtensionTextBox" Style="{StaticResource InputBox}" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Add" Style="{StaticResource SecondaryBtn}" Margin="8,-10,0,0" Click="AddExtensionBtn_Click" Height="30" VerticalAlignment="Center" Padding="16,0" />
                                    </Grid>
                                    <TextBlock x:Name="ExtensionValidationText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="11" Margin="0,0,0,12" Visibility="Collapsed" />
                                    
                                    <!-- FIX: BackgroundSecondaryBrush was undefined; the list had no
                                         visible container fill. -->
                                    <Border Background="{DynamicResource SurfaceTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Height="200" Margin="0,0,0,16">
                                        <ListBox x:Name="ExtensionsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Width="24" Height="24" Padding="0" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextSecondaryBrush}" Click="RemoveExtensionBtn_Click" Tag="{Binding}">
                                                            <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="8" Text="Diagnostics" Style="{StaticResource SectionHeader}" />
                            <Border Grid.Row="9" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox x:Name="EnableLogsCheck" Content="Enable diagnostic logging" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Outputs detailed logs to the VS 'ApexCode' output pane." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="20,2,0,16" TextWrapping="Wrap" />
                                    <Button x:Name="SaveThemeBtn" Content="Save" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Click="SaveThemeBtn_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- PROVIDER TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlug}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,6,0" />
                        <TextBlock Text="Provider" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LLM providers" Style="{StaticResource TabHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center" Margin="0" Click="AddProviderBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add provider" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="0">
                                <Grid>
                                    <!-- List -->
                                    <ListView x:Name="ProvidersList" BorderThickness="0" Background="Transparent" SelectionChanged="ProvidersList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ListView_PreviewMouseWheel">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="Padding" Value="12" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <!-- Disable default blue selection highlight -->
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent">
                                                    <Grid.InputBindings>
                                                        <!-- Clicking anywhere on the row triggers edit -->
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding EditCommand}" />
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource TextPrimaryBrush}">
                                                        <Rectangle.OpacityMask>
                                                            <VisualBrush Stretch="Uniform">
                                                                <VisualBrush.Visual>
                                                                    <svgc:SvgViewbox Source="{Binding LogoResourceKey, Converter={StaticResource LogoKeyToUriConverter}}" Width="24" Height="24" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="Transparent" x:Name="DetailsPanel">
                                                        <!-- We bind to Name/ProviderType/DefaultModel. -->
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" x:Name="NameText" />
                                                        <Grid Margin="0,2,0,0">
                                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="11" x:Name="SubtitleText">
                                                                <Run Text="{Binding DefaultModel}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding ProviderType}" />
                                                            </TextBlock>
                                                            <TextBlock Text="Not connected" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" x:Name="NotConnectedText" Visibility="Collapsed" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" x:Name="ActionsPanel">
                                                        <Button Content="Connect" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="ProviderEditBtn_Click" Tag="{Binding Id}" x:Name="ConnectBtn" Visibility="Collapsed" />
                                                        <Button Style="{StaticResource GhostButton}" Width="28" Height="28" ToolTip="Edit" Padding="0" Click="ProviderEditBtn_Click" Tag="{Binding Id}" Margin="0,0,4,0" x:Name="EditBtn">
                                                            <Path Data="{StaticResource IconEdit}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                        <Button Foreground="{DynamicResource TextSecondaryBrush}" Width="28" Height="28" ToolTip="Delete" Padding="0" Click="DeleteProviderFromList_Click" Tag="{Binding Id}" x:Name="DeleteBtn">
                                                            <Button.Content>
                                                                <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button.Content>
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <!-- BuiltIn provider and NO ApiKey -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBuiltIn}" Value="True" />
                                                            <Condition Binding="{Binding ApiKey}" Value="{x:Null}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ConnectBtn" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="NotConnectedText" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="NameText" Property="Opacity" Value="0.7" />
                                                        <Setter TargetName="DetailsPanel" Property="Opacity" Value="0.7" />
                                                    </MultiDataTrigger>
                                                    
                                                    <!-- BuiltIn provider and NO ApiKey but with empty string instead of null -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBuiltIn}" Value="True" />
                                                            <Condition Binding="{Binding ApiKey}" Value="" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ConnectBtn" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="NotConnectedText" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="NameText" Property="Opacity" Value="0.7" />
                                                        <Setter TargetName="DetailsPanel" Property="Opacity" Value="0.7" />
                                                    </MultiDataTrigger>

                                                    <!-- BuiltIn provider with ApiKey -->
                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                        <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    
                                    <!-- Empty State -->
                                    <StackPanel x:Name="ProvidersEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32">
                                        <Path Data="{StaticResource IconPlug}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="No providers configured yet." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                        <Button Style="{StaticResource SecondaryBtn}" Click="AddProviderBtn_Click" HorizontalAlignment="Center" Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Add provider" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- Edit Provider Modal -->
                    <Border x:Name="ProviderEditOverlay" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="200">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource MediumRadius}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.8}" Margin="32" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock x:Name="ProviderEditTitle" Text="Add provider" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="CloseProviderEditBtn_Click" Padding="4">
                                        <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                                
                                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ProviderErrorTextBlock" Foreground="{DynamicResource ErrorRedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
                                        
                                        <TextBlock Text="Provider type" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="ProviderTypeCombo" Style="{StaticResource Combo}" SelectionChanged="ProviderTypeCombo_SelectionChanged">
                                            <ComboBoxItem Content="OpenAI" Tag="openai" IsSelected="True" />
                                            <ComboBoxItem Content="Azure OpenAI" Tag="azureopenai" />
                                            <ComboBoxItem Content="OpenRouter (Custom)" Tag="openrouter" />
                                            <ComboBoxItem Content="Ollama (Local)" Tag="ollama" />
                                        </ComboBox>

                                        <TextBlock Style="{StaticResource LabelStyle}">
                                            <Run Text="Provider name " />
                                            <Run Text="*" Foreground="{DynamicResource ErrorRedBrush}" />
                                        </TextBlock>
                                        <TextBox x:Name="ProviderNameText" Style="{StaticResource InputBox}" Text="OpenAI" />
                                        <TextBlock x:Name="ProviderNameErrorText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="12" Margin="0,-8,0,12" Visibility="Collapsed" />

                                        <TextBlock Style="{StaticResource LabelStyle}">
                                            <Run Text="Api key " />
                                            <Run Text="*" Foreground="{DynamicResource ErrorRedBrush}" />
                                        </TextBlock>
                                        <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource PasswordInput}" />
                                        <TextBlock x:Name="ApiKeyErrorText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="12" Margin="0,-8,0,12" Visibility="Collapsed" />

                                        <TextBlock Style="{StaticResource LabelStyle}">
                                            <Run Text="Api endpoint " />
                                            <Run Text="*" Foreground="{DynamicResource ErrorRedBrush}" />
                                        </TextBlock>
                                        <TextBox x:Name="ApiEndpointText" Style="{StaticResource InputBox}" Text="https://api.openai.com/v1" />
                                        <TextBlock x:Name="ApiEndpointErrorText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="12" Margin="0,-8,0,12" Visibility="Collapsed" />

                                        <TextBlock Style="{StaticResource LabelStyle}">
                                            <Run Text="Model fetch endpoint " />
                                            <Run Text="*" Foreground="{DynamicResource ErrorRedBrush}" />
                                        </TextBlock>
                                        <TextBox x:Name="ModelFetchEndpointText" Style="{StaticResource InputBox}" Text="https://api.openai.com/v1/models" />
                                        <TextBlock x:Name="ModelFetchEndpointErrorText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="12" Margin="0,-8,0,12" Visibility="Collapsed" />

                                        <TextBlock Text="Default model" Style="{StaticResource LabelStyle}" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:ModelPickerControl x:Name="ModelPicker" Grid.Column="0" Margin="0,0,8,0" RetryClicked="ModelPicker_RetryClicked" />
                                            <Button x:Name="FetchModelsBtn" Grid.Column="1" Content="Fetch models" Style="{StaticResource SecondaryBtn}" Margin="0" Click="FetchModelsBtn_Click" />
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="SaveProviderBtn" Content="Save" Style="{StaticResource PrimaryBtn}" Click="SaveProviderBtn_Click" />
                                        <Button x:Name="TestConnectionBtn" Content="Test connection" Style="{StaticResource SecondaryBtn}" Click="TestConnectionBtn_Click" />
                                    </StackPanel>
                                    <Button x:Name="RemoveProviderBtn" Content="Remove" Style="{StaticResource DestructiveBtn}" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed" Click="RemoveProviderBtn_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- BEHAVIOR TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBrain}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,6,0" />
                        <TextBlock Text="Behavior" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <TextBlock Text="AI Behavior" Style="{StaticResource TabHeaderStyle}" Margin="0,0,0,16" />
                            <Border Background="{DynamicResource SurfaceTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GitStatusIcon" Text="⏳" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock x:Name="GitStatusText" Text="Checking Git status..." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Tool Permissions" Style="{StaticResource SectionHeader}" />
                        <Border Grid.Row="2" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Require approval before the AI executes certain actions." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" />
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Read Files" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ReadFilesApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0">
                                        <ComboBoxItem Content="Allow all actions" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each action" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all actions" Tag="denyall" />
                                    </ComboBox>
                                </Grid>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Create Files" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CreateFileApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0">
                                        <ComboBoxItem Content="Allow all actions" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each action" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all actions" Tag="denyall" />
                                    </ComboBox>
                                </Grid>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Edit Files" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ReplaceFileApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0">
                                        <ComboBoxItem Content="Allow all actions" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each action" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all actions" Tag="denyall" />
                                    </ComboBox>
                                </Grid>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Execute Commands" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ExecuteCommandApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0" SelectionChanged="ExecuteCommandApprovalCombo_SelectionChanged">
                                        <ComboBoxItem Content="Allow all actions" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each action" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all actions" Tag="denyall" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Read Database Data" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DatabaseQueryApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0">
                                        <ComboBoxItem Content="Use connection setting" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each query" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all queries" Tag="denyall" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Read Database Schema" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DatabaseSchemaApprovalCombo" Grid.Column="1" Style="{StaticResource Combo}" Margin="0">
                                        <ComboBoxItem Content="Use connection setting" Tag="allowall" />
                                        <ComboBoxItem Content="Prompt for each read" Tag="prompt" />
                                        <ComboBoxItem Content="Deny all schema reads" Tag="denyall" />
                                    </ComboBox>
                                </Grid>
                                <StackPanel x:Name="CommandWhitelistPanel" Visibility="Collapsed">
                                    <TextBlock Text="Command Whitelist" Style="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
                                    <TextBlock Text="Commands that start with these prefixes will be allowed automatically. All other commands will prompt for permission." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" />
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewCommandTextBox" Style="{StaticResource InputBox}" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Add" Style="{StaticResource SecondaryBtn}" Margin="8,-10,0,0" Click="AddCommandBtn_Click" Height="30" VerticalAlignment="Center" Padding="16,0" />
                                    </Grid>
                                    <TextBlock x:Name="CommandValidationText" Foreground="{DynamicResource ErrorRedBrush}" FontSize="11" Margin="0,0,0,12" Visibility="Collapsed" />
                                    
                                    <!-- FIX: BackgroundSecondaryBrush was undefined; the list had no
                                         visible container fill. -->
                                    <Border Background="{DynamicResource SurfaceTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Height="200">
                                        <ListBox x:Name="CommandsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Width="24" Height="24" Padding="0" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextSecondaryBrush}" Click="RemoveCommandBtn_Click" Tag="{Binding}">
                                                            <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Text="Automation" Style="{StaticResource SectionHeader}" />
                        <Border Grid.Row="4" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="AutoHealCheck" Content="Enable auto-healing (fix compile errors)" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" />
                                <TextBlock Text="AI automatically attempts to fix code if a build error occurs." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="20,2,0,16" TextWrapping="Wrap" />

                                <CheckBox x:Name="SemanticSearchCheck" Content="Enable semantic code search (Experimental)" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Checked="SemanticSearchCheck_Changed" Unchecked="SemanticSearchCheck_Changed" />
                                <TextBlock Text="Enables background indexing of your codebase for context retrieval." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="20,2,0,4" TextWrapping="Wrap" />

                                <Grid Margin="20,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TriggerIndexBtn" Grid.Column="0" Content="Trigger manual index" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Click="TriggerIndexBtn_Click" />
                                    <Button x:Name="StopIndexBtn" Grid.Column="0" Content="Stop" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Click="StopIndexBtn_Click" Visibility="Collapsed" />
                                    <ProgressBar x:Name="IndexProgress" Grid.Column="1" IsIndeterminate="True" Height="4" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0" />
                                    <Button x:Name="AdvancedIndexBtn" Grid.Column="2" Content="Advanced ▼" Style="{StaticResource SecondaryBtn}" Click="AdvancedIndexBtn_Click" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- FIX: BackgroundSecondaryBrush was undefined; the log panel had
                                     no visible container fill. -->
                                <Border x:Name="AdvancedIndexPanel" Margin="20,12,0,0" Visibility="Collapsed" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Padding="8" Height="150">
                                    <ScrollViewer x:Name="AdvancedIndexScroll" VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="IndexLogsText" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" AcceptsReturn="True" />
                                    </ScrollViewer>
                                </Border>
                                
                                <StackPanel x:Name="ModelDownloadPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Semantic Search models are missing." Foreground="{DynamicResource ErrorRedBrush}" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DownloadModelsBtn" Grid.Column="0" Content="Download Models" Style="{StaticResource PrimaryBtn}" Click="DownloadModelsBtn_Click" />
                                        <ProgressBar x:Name="ModelDownloadProgress" Grid.Column="1" Height="4" Margin="16,0,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="ModelDownloadStatusText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>


                        <TextBlock Grid.Row="5" Text="Agent Resilience" Style="{StaticResource SectionHeader}" />
                        <Border Grid.Row="6" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Configure how the AI handles errors, retries, and recovery. Higher values allow more autonomous recovery but use more API calls."
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <!-- Max Tool Iterations -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max tool iterations per request" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="Maximum number of tool calls the AI can make in a single request before stopping."
                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="MaxToolIterationsBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                             Text="50" VerticalContentAlignment="Center" HorizontalAlignment="Right" Width="80" />
                                </Grid>

                                <!-- Max Consecutive Mistakes -->
                                <Grid Margin="0,0,0,12">
                                    <!-- Same two-column layout as above -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max consecutive mistakes" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="Number of consecutive tool errors before escalating to user."
                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="MaxConsecutiveMistakesBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                             Text="3" VerticalContentAlignment="Center" HorizontalAlignment="Right" Width="80" />
                                </Grid>

                                <!-- Max Auto-Retry Attempts -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max auto-retry attempts" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="Number of automatic retries for API errors before asking user."
                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="MaxAutoRetryBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                             Text="3" VerticalContentAlignment="Center" HorizontalAlignment="Right" Width="80" />
                                </Grid>

                                <!-- Max Stream Retries -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max stream retries" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="Retries for streaming failures (mid-stream drops, connection errors)."
                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="MaxStreamRetriesBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                             Text="3" VerticalContentAlignment="Center" HorizontalAlignment="Right" Width="80" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="9" Margin="0,24,0,0">
                            <Button x:Name="SaveBehaviorBtn" Content="Save" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Click="SaveBehaviorBtn_Click" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- PROMPTS TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDocument}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,6,0" />
                        <TextBlock Text="Prompts" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="System Prompts &amp; Personas" Style="{StaticResource TabHeaderStyle}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                    Personas define the AI's core behavior, tone, and context. By switching your active persona, you can instantly reconfigure the assistant for different tasks (e.g., UI Design vs. Database Architecture) without having to rewrite long system prompts every time.
                                </TextBlock>
                            </StackPanel>



                            <Grid Grid.Row="3" Margin="0,16,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Manage personas" Style="{StaticResource SectionHeader}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center" Margin="0" Click="AddPersonaBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add persona" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <Border Grid.Row="4" Style="{StaticResource SettingsCard}" Padding="0">
                                <ListView x:Name="PersonasList" Height="160" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <svgc:SvgViewbox Grid.Column="0" Source="{Binding IconResourceKey, Converter={StaticResource PersonaLogoKeyToUriConverter}}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="★" Foreground="{DynamicResource WarningOrangeBrush}" FontSize="14" Margin="0,0,16,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                                                    <Button Content="Edit" Style="{StaticResource GhostButton}" ToolTip="Edit Persona" Padding="8,4" Click="PersonaEditBtn_Click" Tag="{Binding Id}" Margin="0,0,4,0" />
                                                    <Button Width="28" Height="28" ToolTip="Delete" Padding="0" Click="DeletePersonaFromList_Click" Tag="{Binding Id}">
                                                        <Button.Content>
                                                            <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button.Content>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                            
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- Edit Persona Modal -->
                    <Border x:Name="PersonaEditOverlay" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="200">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource MediumRadius}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.8}" Margin="32" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="PersonaEditTitle" Text="Add persona" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="ClosePersonaEditBtn_Click" />
                                </Grid>
                                
                                <TextBlock x:Name="PersonaEditErrorText" Grid.Row="1" Foreground="{DynamicResource ErrorRedBrush}" Margin="0,0,0,16" Visibility="Collapsed" TextWrapping="Wrap" />
                                
                                <ScrollViewer Grid.Row="2" MaxHeight="600" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Persona name" Style="{StaticResource LabelStyle}" Margin="0" />
                                            <TextBlock Text="*" Foreground="{DynamicResource ErrorRedBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBox x:Name="PersonaNameText" Style="{StaticResource InputBox}" />
                                        <TextBlock x:Name="PersonaNameErrorText" Foreground="{DynamicResource ErrorRedBrush}" Margin="0,4,0,12" FontSize="11" Visibility="Collapsed" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Persona description" Style="{StaticResource LabelStyle}" Margin="0" />
                                            <TextBlock Text="*" Foreground="{DynamicResource ErrorRedBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBox x:Name="PersonaDescText" Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" Height="NaN" VerticalScrollBarVisibility="Auto" />
                                        <TextBlock x:Name="PersonaDescErrorText" Foreground="{DynamicResource ErrorRedBrush}" Margin="0,4,0,0" FontSize="11" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <Grid Grid.Row="3" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="UpdatePersonaBtn" Content="Save" Style="{StaticResource PrimaryBtn}" Click="UpdatePersonaBtn_Click" />
                                        <Button x:Name="SetDefaultPersonaBtn" Content="Set default" Style="{StaticResource SecondaryBtn}" Click="SetDefaultPersonaBtn_Click" />
                                    </StackPanel>
                                    <Button x:Name="DeletePersonaBtn" Content="Delete" Style="{StaticResource DestructiveBtn}" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed" Click="DeletePersonaBtn_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- DATABASE TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDatabase}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,6,0" />
                        <TextBlock Text="Database" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database connections" Style="{StaticResource TabHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center" Margin="0" Click="AddDbBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add connection" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="0">
                                <Grid>
                                    <ListView x:Name="DatabaseConnectionsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ListView_PreviewMouseWheel">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="Padding" Value="12" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <svgc:SvgViewbox Grid.Column="0" Source="pack://application:,,,/AiAssistant.UI;component/Resources/PersonaLogos/sqlserver.svg" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,2,0,0">
                                                            <Run Text="{Binding ServerAddress}" />
                                                            <Run Text=" • " />
                                                            <Run Text="{Binding DatabaseName}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Width="28" Height="28" ToolTip="Edit" Padding="0" Click="DbEditBtn_Click" Tag="{Binding Id}" Margin="0,0,4,0">
                                                            <Path Data="{StaticResource IconEdit}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                        <Button Foreground="{DynamicResource TextSecondaryBrush}" Width="28" Height="28" ToolTip="Delete" Padding="0" Click="DeleteDbFromList_Click" Tag="{Binding Id}">
                                                            <Button.Content>
                                                                <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button.Content>
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    
                                    <Grid x:Name="DbEmptyState" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="300">
                                        <!-- FIX: SurfaceSecondaryBrush was undefined; the dashed
                                             empty-state placeholder had no fill in either theme. -->
                                        <Rectangle Stroke="{DynamicResource BorderSubtleBrush}" StrokeThickness="1.5" StrokeDashArray="6 4" RadiusX="12" RadiusY="12" Fill="{DynamicResource SurfaceTertiaryBrush}" Margin="24" Opacity="0.5"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                                            <Border Background="{DynamicResource SurfaceTertiaryBrush}" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                                                <svgc:SvgViewbox Source="pack://application:,,,/AiAssistant.UI;component/Resources/PersonaLogos/sqlserver.svg" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                            </Border>
                                            <TextBlock Text="No database connections yet" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock Text="Add a connection to a SQL Server database to enable AI-powered data queries and analysis directly from your prompts." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="20"/>
                                            <Button Content="+ Add Database Connection" Style="{StaticResource SecondaryBtn}" Click="AddDbBtn_Click" HorizontalAlignment="Center" Padding="20,10" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- Edit Database Modal -->
                    <Border x:Name="DbEditOverlay" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="200">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource MediumRadius}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.8}" Margin="32" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock x:Name="DbEditTitle" Text="Add connection" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="CloseDbEditBtn_Click" />
                                </Grid>
                                
                                <ScrollViewer Grid.Row="1" MaxHeight="450" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Connection name *" Style="{StaticResource LabelStyle}" />
                                        <TextBox x:Name="DbNameText" Style="{StaticResource InputBox}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Server address *" Style="{StaticResource LabelStyle}" Margin="0" />
                                                    <!-- FIX: AccentBrush was undefined; this spinner rendered
                                                         with WPF's default black foreground instead of the
                                                         app's accent color. -->
                                                    <ProgressBar x:Name="DbServerScanProgress" Grid.Column="1" IsIndeterminate="True" Width="12" Height="12" Visibility="Collapsed" Foreground="{DynamicResource AccentPrimaryBrush}" ToolTip="Scanning network for servers..." />
                                                </Grid>
                                                <Grid>
                                                    <TextBox x:Name="DbServerText" Style="{StaticResource InputBox}" Text="localhost" GotFocus="DbServerText_GotFocus" TextChanged="DbServerText_TextChanged" />
                                                    <Popup x:Name="DbServerPopup" PlacementTarget="{Binding ElementName=DbServerText}" StaysOpen="False" MaxHeight="200" Width="{Binding ActualWidth, ElementName=DbServerText}">
                                                        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
                                                            <ListBox x:Name="DbServerList" Background="Transparent" BorderThickness="0" SelectionChanged="DbServerList_SelectionChanged">
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem">
                                                                        <Setter Property="Padding" Value="8,4" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </Style>
                                                                </ListBox.ItemContainerStyle>
                                                            </ListBox>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Database name *" Style="{StaticResource LabelStyle}" />
                                                <TextBox x:Name="DbDatabaseText" Style="{StaticResource InputBox}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Authentication" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="DbAuthCombo" Style="{StaticResource Combo}" SelectionChanged="DbAuthCombo_SelectionChanged">
                                            <ComboBoxItem Content="Windows Authentication" Tag="WindowsAuth" IsSelected="True" />
                                            <ComboBoxItem Content="SQL Server Authentication" Tag="SqlAuth" />
                                        </ComboBox>

                                        <Grid x:Name="DbCredentialsGrid" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Username (SQL Auth) *" Style="{StaticResource LabelStyle}" />
                                                <TextBox x:Name="DbUsernameText" Style="{StaticResource InputBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Password (Encrypted) *" Style="{StaticResource LabelStyle}" />
                                                <PasswordBox x:Name="DbPasswordBox" Style="{StaticResource PasswordInput}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Permission level" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="DbPermissionCombo" Style="{StaticResource Combo}">
                                            <ComboBoxItem Content="Read Only" Tag="ReadOnly" IsSelected="True" />
                                        </ComboBox>

                                        <TextBlock Text="Database tools only read data in Plan and Act modes. Use a SQL Server account restricted to the tables and views the agent may read." TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12" />
                                        <CheckBox x:Name="DbRequireApprovalCheck" Content="Require approval before reading schema or data" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" IsChecked="True" />
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="SaveDbBtn" Content="Save" Style="{StaticResource PrimaryBtn}" Click="SaveDbBtn_Click" />
                                        <Button x:Name="TestDbBtn" Content="Test connection" Style="{StaticResource SecondaryBtn}" Click="TestDbBtn_Click" />
                                        <ProgressBar x:Name="DbTestProgress" IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Overlay: themed in-panel replacement for Win32 MessageBox dialogs -->
        <local:ConfirmationOverlay x:Name="ConfirmOverlay" Grid.RowSpan="2" Panel.ZIndex="300" />
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light Theme Palette -->
    <!-- UI Surface Colors (Overrides SharedResources.xaml) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceColorBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="#E5E5E5" />
    
    <!-- FIX: was #1E1E1E (a dark gray, ~88% black). Requested true dark-black body
         text for the light theme for stronger contrast/readability. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#999999" />
    
    <!-- FIX: was #CCCCCC — too close to the page/card background to read as an
         outline, which is why combo boxes and settings cards looked borderless.
         Darkened to a visible mid-gray so every card, combo box and text box
         actually shows its edge on a white/light-gray background. -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#AFAFAF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FAFAFA" />
    <!-- FIX: matched to the same darker border family as BorderSubtleBrush above,
         for the same reason (was too faint to read as an outline). -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#AFAFAF" />
    <Color x:Key="AccentPrimary">#6D28D9</Color>
    <Color x:Key="AccentHover">#7C3AED</Color>
    <Color x:Key="AccentSurface">#146D28D9</Color>
    
    <Color x:Key="BorderFocus">#6D28D9</Color>
    
    <Color x:Key="CodeBackground">#F5F6FB</Color>
    <Color x:Key="CodeBorder">#E2E3F0</Color>
    
    <Color x:Key="UserBubbleBg">#106D28D9</Color>
    <Color x:Key="AssistantBubbleBg">#F5F6FB</Color>
    
    <Color x:Key="ErrorRed">#DC2626</Color>
    <Color x:Key="ErrorBg">#FEF2F2</Color>
    
    <Color x:Key="SuccessGreen">#16A34A</Color>
    <Color x:Key="WarningOrange">#D97706</Color>
    
    <Color x:Key="SendButtonBg">#6D28D9</Color>

    <!-- Semantic Operation Colors -->
    <Color x:Key="SystemPromptColor">#E5E5E5</Color>
    <Color x:Key="AssistantResponseColor">#8B949E</Color>
    <Color x:Key="ReadOperationColor">#0F766E</Color>
    <Color x:Key="WriteOperationColor">#0F766E</Color>
    <Color x:Key="DataOperationColor">#2563EB</Color>
    <Color x:Key="TerminalOperationColor">#7C3AED</Color>
    <Color x:Key="BrowserOperationColor">#7C3AED</Color>
    <Color x:Key="TaskSuccessColor">#56D364</Color>

    <sys:Double x:Key="BaseAppFontSize">13</sys:Double>
    <sys:Double x:Key="BaseMessageFontSize">13</sys:Double>
    <sys:Double x:Key="BaseInputFontSize">13</sys:Double>
    <sys:Double x:Key="BaseCodeFontSize">13</sys:Double>
    <sys:Double x:Key="BaseSmallFontSize">11</sys:Double>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">

    <!-- Dimensions & Spacing -->
    <CornerRadius x:Key="SmallRadius">4</CornerRadius>
    <CornerRadius x:Key="MediumRadius">8</CornerRadius>
    <CornerRadius x:Key="LargeRadius">12</CornerRadius>

    <sys:Double x:Key="SpacingSmall">4</sys:Double>
    <sys:Double x:Key="SpacingMedium">8</sys:Double>
    <sys:Double x:Key="SpacingLarge">16</sys:Double>

    <!-- Typography -->
    <FontFamily x:Key="AppFont">Segoe UI, Helvetica Neue, Inter, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFont">Consolas, Courier New, monospace</FontFamily>

    <sys:Double x:Key="AppFontSizeOverride">13</sys:Double>
    <sys:Double x:Key="MessageFontSizeOverride">13</sys:Double>
    <sys:Double x:Key="InputFontSizeOverride">13</sys:Double>
    <sys:Double x:Key="CodeFontSizeOverride">13</sys:Double>
    <!-- Captions: timestamps, chip labels, section headers. Previously referenced
         by name in ChatPanel without ever being defined, so every "small" label
         silently fell back to the inherited size and ignored the user's font
         preference. It now exists and scales with the message offset. -->
    <sys:Double x:Key="SmallFontSizeOverride">11</sys:Double>

    <!-- Dynamic Brushes based on current theme's Colors -->
    <!-- These bind to Colors that must be defined in LightTheme.xaml / DarkTheme.xaml -->

    <!-- FIX (VS Theming): Chrome/surface/text/border brushes now follow the live VS
         color theme via EnvironmentColors instead of our own hardcoded hex palette.
         This makes the extension look correct on any VS theme (Dark, Light, Blue,
         custom themes like Solarized) and follow VS's "Sync with OS setting" automatically,
         since EnvironmentColors resources are updated in-place by VS when the theme changes.
         Brand/accent colors below remain our own palette since they have no VS equivalent. -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundColorKey}}" />
    <SolidColorBrush x:Key="SurfaceColorBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundColorKey}}" />
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ScrollBarBackgroundColorKey}}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.PanelTextColorKey}}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ControlEditHintTextColorKey}}" />
    
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHover}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{DynamicResource AccentSurface}" />
    
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderColorKey}}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource BorderFocus}" />
    
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{DynamicResource CodeBackground}" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="{DynamicResource CodeBorder}" />
    
    <SolidColorBrush x:Key="UserBubbleBgBrush" Color="{DynamicResource UserBubbleBg}" />
    <SolidColorBrush x:Key="AssistantBubbleBgBrush" Color="{DynamicResource AssistantBubbleBg}" />
    
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{DynamicResource ErrorRed}" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{DynamicResource ErrorBg}" />
    
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{DynamicResource SuccessGreen}" />
    <SolidColorBrush x:Key="WarningOrangeBrush" Color="{DynamicResource WarningOrange}" />
    
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundColorKey}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderColorKey}}" />
    <SolidColorBrush x:Key="SendButtonBgBrush" Color="{DynamicResource SendButtonBg}" />
    
    <SolidColorBrush x:Key="SystemPromptBrush" Color="{DynamicResource SystemPromptColor}" />
    <SolidColorBrush x:Key="AssistantResponseBrush" Color="{DynamicResource AssistantResponseColor}" />
    <SolidColorBrush x:Key="ReadOperationBrush" Color="{DynamicResource ReadOperationColor}" />
    <SolidColorBrush x:Key="WriteOperationBrush" Color="{DynamicResource WriteOperationColor}" />
    <SolidColorBrush x:Key="DataOperationBrush" Color="{DynamicResource DataOperationColor}" />
    <SolidColorBrush x:Key="TerminalOperationBrush" Color="{DynamicResource TerminalOperationColor}" />
    <SolidColorBrush x:Key="BrowserOperationBrush" Color="{DynamicResource BrowserOperationColor}" />
    <SolidColorBrush x:Key="TaskSuccessBrush" Color="{DynamicResource TaskSuccessColor}" />
    
</ResourceDictionary>

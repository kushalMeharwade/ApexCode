<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark Theme Palette -->
    <!-- UI Surface Colors (Overrides SharedResources.xaml) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceColorBrush" Color="#252526" />
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="#2D2D30" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#999999" />
    
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#333337" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3F3F46" />
    <Color x:Key="AccentPrimary">#7C3AED</Color>
    <Color x:Key="AccentHover">#9B59FF</Color>
    <Color x:Key="AccentSurface">#147C3AED</Color> <!-- Transparent purple approximation -->
    
    <Color x:Key="BorderFocus">#7C3AED</Color>
    
    <Color x:Key="CodeBackground">#161728</Color>
    <Color x:Key="CodeBorder">#2E2F4A</Color>
    
    <Color x:Key="UserBubbleBg">#187C3AED</Color>
    <Color x:Key="AssistantBubbleBg">#252640</Color>
    
    <Color x:Key="ErrorRed">#FF6B6B</Color>
    <Color x:Key="ErrorBg">#3D1A1A</Color>
    
    <Color x:Key="SuccessGreen">#4ADE80</Color>
    <Color x:Key="WarningOrange">#F59E0B</Color>
    
    <Color x:Key="SendButtonBg">#7C3AED</Color>

    <!-- Semantic Operation Colors -->
    <Color x:Key="SystemPromptColor">#E5E5E5</Color>
    <Color x:Key="AssistantResponseColor">#8B949E</Color>
    <Color x:Key="ReadOperationColor">#2DD4BF</Color>
    <Color x:Key="WriteOperationColor">#2DD4BF</Color>
    <Color x:Key="DataOperationColor">#60A5FA</Color>
    <Color x:Key="TerminalOperationColor">#A78BFA</Color>
    <Color x:Key="BrowserOperationColor">#A78BFA</Color>
    <Color x:Key="TaskSuccessColor">#56D364</Color>

    <sys:Double x:Key="BaseAppFontSize">13</sys:Double>
    <sys:Double x:Key="BaseMessageFontSize">13</sys:Double>
    <sys:Double x:Key="BaseInputFontSize">13</sys:Double>
    <sys:Double x:Key="BaseCodeFontSize">13</sys:Double>
    <sys:Double x:Key="BaseSmallFontSize">11</sys:Double>

</ResourceDictionary>

<Window x:Class="ApexCode.UI.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexCode" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Context info -->
        <TextBlock x:Name="ContextLabel" Grid.Row="0" Margin="0,0,0,5" Foreground="#9CDCFE" TextWrapping="Wrap"/>
        
        <!-- Input area -->
        <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#252526" Foreground="White" BorderBrush="#3F3F46"
                 Padding="5" VerticalScrollBarVisibility="Auto"
                 PreviewKeyDown="InputTextBox_PreviewKeyDown"/>
                 
        <!-- Validation error -->
        <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#F48771" Visibility="Collapsed" Margin="0,5,0,0" Text="Please enter a request."/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Execute" Width="80" Margin="0,0,10,0" Click="Execute_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="5"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click" Background="#3F3F46" Foreground="White" BorderThickness="0" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>

// =============================================================================
// Binding redirects for ApexCode VSIX extension.
//
// These redirects are defined manually here instead of via
// [assembly: ProvideBindingRedirection(...)] attributes because the VSSDK
// CreatePkgDef tool has a known bug: its version string parser cannot handle
// version components with more than one digit (e.g., "10.0.0.10" fails).
// This file is included directly in the VSIX via <VSIXSourceItem> and is
// merged into the extension's .pkgdef at install time.
//
// Format reference:
//   [$RootKey$\RuntimeConfiguration\dependentAssembly\bindingRedirection\{GUID}]
//   "name"="AssemblyName"
//   "publicKeyToken"="TOKEN"
//   "culture"="neutral"
//   "oldVersion"="0.0.0.0-NEW"
//   "newVersion"="NEW"
//   "codeBase"="$PackageFolder$\AssemblyName.dll"
//
// Assembly versions verified by inspecting the actual DLLs in bin\Debug
// via [System.Reflection.AssemblyName]::GetAssemblyName().
// =============================================================================


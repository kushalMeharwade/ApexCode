  <!--
    Force critical transitive NuGet dependencies into the VSIX.
    The VSSDK packaging targets skip these because they lack IncludeInVSIX metadata.
    Without this, assemblies exist in bin\Debug but are missing from the .vsix at runtime.
  -->
  <Target Name="IncludeMissingAssembliesInVSIX" BeforeTargets="GetVsixSourceItems">
    <Copy SourceFiles="$(TargetDir)x64\SQLite.Interop.dll"
          DestinationFiles="$(TargetDir)SQLite.Interop.dll"
          Condition="Exists('$(TargetDir)x64\SQLite.Interop.dll') and !Exists('$(TargetDir)SQLite.Interop.dll')" />    <ItemGroup>
      <!-- Project reference assemblies that VSIX packaging might skip -->
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.Core.dll" Condition="Exists('$(TargetDir)AiAssistant.Core.dll')" />
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.Storage.dll" Condition="Exists('$(TargetDir)AiAssistant.Storage.dll')" />
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.Llm.dll" Condition="Exists('$(TargetDir)AiAssistant.Llm.dll')" />
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.Engine.dll" Condition="Exists('$(TargetDir)AiAssistant.Engine.dll')" />
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.Tools.dll" Condition="Exists('$(TargetDir)AiAssistant.Tools.dll')" />
      <VSIXSourceItem Include="$(TargetDir)AiAssistant.UI.dll" Condition="Exists('$(TargetDir)AiAssistant.UI.dll')" />
      <!-- Async / JSON / runtime polyfills -->
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" Condition="Exists('$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Text.Json.dll" Condition="Exists('$(TargetDir)System.Text.Json.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Text.Encodings.Web.dll" Condition="Exists('$(TargetDir)System.Text.Encodings.Web.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" Condition="Exists('$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" Condition="Exists('$(TargetDir)System.Threading.Tasks.Extensions.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Buffers.dll" Condition="Exists('$(TargetDir)System.Buffers.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Memory.dll" Condition="Exists('$(TargetDir)System.Memory.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Numerics.Vectors.dll" Condition="Exists('$(TargetDir)System.Numerics.Vectors.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Diagnostics.DiagnosticSource.dll" Condition="Exists('$(TargetDir)System.Diagnostics.DiagnosticSource.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.IO.Pipelines.dll" Condition="Exists('$(TargetDir)System.IO.Pipelines.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Configuration.ConfigurationManager.dll" Condition="Exists('$(TargetDir)System.Configuration.ConfigurationManager.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.ValueTuple.dll" Condition="Exists('$(TargetDir)System.ValueTuple.dll')" />
      <!-- SQLite native library - place both at root and in x64 path for P/Invoke probing -->
      <VSIXSourceItem Include="$(TargetDir)SQLite.Interop.dll" Condition="Exists('$(TargetDir)SQLite.Interop.dll')" />
      <VSIXSourceItem Include="$(TargetDir)x64\SQLite.Interop.dll" Condition="Exists('$(TargetDir)x64\SQLite.Interop.dll')">
        <VSIXSubPath>x64</VSIXSubPath>
      </VSIXSourceItem>
      <!-- MessagePack (transitive dependency) -->
      <VSIXSourceItem Include="$(TargetDir)MessagePack.dll" Condition="Exists('$(TargetDir)MessagePack.dll')" />
      <VSIXSourceItem Include="$(TargetDir)MessagePack.Annotations.dll" Condition="Exists('$(TargetDir)MessagePack.Annotations.dll')" />
      <!-- SqlClient native SNI (x64 for VS 2022) -->
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Data.SqlClient.SNI.x64.dll" Condition="Exists('$(TargetDir)Microsoft.Data.SqlClient.SNI.x64.dll')" />
      <!-- Security/crypto assemblies for SqlClient -->
      <VSIXSourceItem Include="$(TargetDir)System.Security.AccessControl.dll" Condition="Exists('$(TargetDir)System.Security.AccessControl.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Security.Principal.Windows.dll" Condition="Exists('$(TargetDir)System.Security.Principal.Windows.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Win32.Registry.dll" Condition="Exists('$(TargetDir)Microsoft.Win32.Registry.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.IO.Redist.dll" Condition="Exists('$(TargetDir)Microsoft.IO.Redist.dll')" />
      <!-- ML and AI assemblies -->
      <VSIXSourceItem Include="$(TargetDir)Microsoft.ML.Tokenizers.dll" Condition="Exists('$(TargetDir)Microsoft.ML.Tokenizers.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.ML.OnnxRuntime.dll" Condition="Exists('$(TargetDir)Microsoft.ML.OnnxRuntime.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Extensions.AI.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.AI.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Extensions.AI.Abstractions.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.AI.Abstractions.dll')" />
      <!-- FIX Feature 8: MEAI provider assemblies + their SDK dependencies.
           These are transitive (pulled in via the AiAssistant.Llm project reference) and were
           previously omitted from the VSIX. Without them, ChatClientFactory's OpenAIChatClient /
           OllamaChatClient / AzureOpenAIClient throw FileNotFoundException at runtime, silently
           breaking the entire LLM layer (the AssemblyResolve fallback can only find assemblies that
           actually ship in the extension directory). -->
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Extensions.AI.OpenAI.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.AI.OpenAI.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Extensions.AI.Ollama.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.AI.Ollama.dll')" />
      <VSIXSourceItem Include="$(TargetDir)OpenAI.dll" Condition="Exists('$(TargetDir)OpenAI.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Azure.AI.OpenAI.dll" Condition="Exists('$(TargetDir)Azure.AI.OpenAI.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Azure.Core.dll" Condition="Exists('$(TargetDir)Azure.Core.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Azure.Identity.dll" Condition="Exists('$(TargetDir)Azure.Identity.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.ClientModel.dll" Condition="Exists('$(TargetDir)System.ClientModel.dll')" />
      <VSIXSourceItem Include="$(TargetDir)System.Memory.Data.dll" Condition="Exists('$(TargetDir)System.Memory.Data.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Bcl.Memory.dll" Condition="Exists('$(TargetDir)Microsoft.Bcl.Memory.dll')" />
      <VSIXSourceItem Include="$(TargetDir)Microsoft.Bcl.HashCode.dll" Condition="Exists('$(TargetDir)Microsoft.Bcl.HashCode.dll')" />
      <!-- ONNX Runtime native library -->
      <VSIXSourceItem Include="$(ProjectDir)onnxruntime.dll" Condition="Exists('$(ProjectDir)onnxruntime.dll')">
        <VSIXSubPath>runtimes\win-x64\native</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(ProjectDir)onnxruntime.dll" Condition="Exists('$(ProjectDir)onnxruntime.dll')">
        <TargetPath>onnxruntime.dll</TargetPath>
      </VSIXSourceItem>
      <!-- Manually-authored pkgdef with binding redirects.
           CreatePkgDef cannot parse version components > 9 (e.g. 10.0.0.10),
           so we bypass it entirely by including the pkgdef directly in the VSIX. -->
      <VSIXSourceItem Include="$(ProjectDir)bindingRedirects.pkgdef" />
    </ItemGroup>
  </Target>
